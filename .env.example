# Local development: copy to .env and fill the provider-issued Bearer Token.
# On Render, set this in Environment instead. Never upload .env.
CTRIP_MCP_TOKEN=

# Observed domestic MCP coordinates use GCJ-02; normalized to WGS84 internally.
CTRIP_MCP_COORDINATE_SYSTEM=gcj02

# Optional: users can continue entering their own DeepSeek key in the page.
DEEPSEEK_API_KEY=

# Optional endpoint overrides. Blank uses the built-in default.
DEEPSEEK_API_URL=
TRANSPORT_ROUTER_URL=
WALKING_ROUTER_URL=

# Legacy POI adapter, used only without CTRIP_MCP_TOKEN.
CTRIP_API_BASE_URL=
CTRIP_API_KEY=

# Optional legacy photo provider; blank keeps Baidu search.
MAPILLARY_ACCESS_TOKEN=
